        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"report_date\": \"2026-05-30\"\n}"
        },
        "url": {
          "raw": "{{SUPABASE_URL}}/rest/v1/rpc/get_sales_dashboard",
          "host": ["{{SUPABASE_URL}}"],
          "path": ["rest", "v1", "rpc", "get_sales_dashboard"]
        }
      }
    },
    {
      "name": "Fetch Orders (sales_dashboard.orders)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "apikey", "value": "{{SUPABASE_ANON_KEY}}", "type": "text" },
          { "key": "Authorization", "value": "Bearer {{SUPABASE_ANON_KEY}}", "type": "text" }
        ],
        "url": {
          "raw": "{{SUPABASE_URL}}/rest/v1/orders?select=*",
          "host": ["{{SUPABASE_URL}}"],
          "path": ["rest", "v1", "orders"],
          "query": [
            { "key": "select", "value": "*" }
          ]
        }
      }
    },
    {
      "name": "Fetch Users (sales_dashboard.users)",
